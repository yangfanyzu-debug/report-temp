REPORT_UPLOAD_DIR=/appdata/report-management/uploaded_reports
REPORT_INITIAL_REPORT_DIR=/appdata/report-management/initial_reports
REPORT_PUBLIC_API_PREFIX=/report-management-api
REPORT_PORT=8045
REPORT_LOG_LEVEL=INFO

REPORT_MYSQL_HOST=127.0.0.1
REPORT_MYSQL_PORT=3306
REPORT_MYSQL_USER=root
REPORT_MYSQL_PASSWORD=<set-outside-git>
REPORT_MYSQL_DATABASE=ry-cloud

ARK_API_URL=https://ark.cn-beijing.volces.com/api/coding/v3
ARK_MODEL=ark-code-latest
ARK_API_KEY=<set-outside-git>

REPORT_WORKER_INTERVAL_SECONDS=15

# 仅用于联调：允许初审通过后使用新的 generationId 继续登记，联调结束后必须关闭。
REPORT_BATCH_DEBUG_REREGISTRATION=false

# 仅用于联调环境：显式开放后端自带的模拟JIRA接口，正式环境保持关闭。
REPORT_MOCK_JIRA_ENABLED=false

# 初审通过后创建JIRA；内网部署时配置为实际接口地址。
REPORT_JIRA_CREATE_URL=http://10.2.64.36:9212/osenv/cap/confirm/jira
REPORT_JIRA_TIMEOUT_SECONDS=30
