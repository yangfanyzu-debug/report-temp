[Unit]
Description=Report Management API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/report-management/backend
EnvironmentFile=/opt/report-management/backend/.env
ExecStart=/opt/report-management/backend/.venv/bin/gunicorn -w 2 -b 0.0.0.0:5010 run:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
